# OpenAI (server-only) — GPT-4o vision for consignor intake
OPENAI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Auth: keep Confirm email ON. Add Site URL + Redirect URLs:
#   {NEXT_PUBLIC_SITE_URL}/verify-email
#   http://localhost:3000/verify-email
ADMIN_PASSWORD=hammer

# Helcim (sandbox first — paste the developer test API token Helcim emails you)
# Sandbox: https://api.helcim.test/v2
# Production: https://api.helcim.com/v2
HELCIM_API_TOKEN=
HELCIM_API_BASE_URL=https://api.helcim.test/v2
HELCIM_CURRENCY=CAD
HELCIM_BID_PREAUTH_AMOUNT=50
NEXT_PUBLIC_HELCIM_PAY_JS=https://secure.helcim.app/helcim-pay/services/start.js

# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/sunday-preauth
# (Sunday $50 holds + forfeit denied paddles after 18:00 America/Edmonton)
CRON_SECRET=

# Pickup copy (fulfillment only — payment is Helcim, not cash or e-Transfer)
NEXT_PUBLIC_PICKUP_INSTRUCTIONS=DealFinder Auctions desk — lots are paid online with Helcim before pickup. Bring photo ID that matches your bidder profile. Pickup window: weekdays 10:00–18:00.

# Email (optional) — Resend for live sends; otherwise admin uses demo outbox
# Test mode: use onboarding@resend.dev (only delivers to the Resend account email)
RESEND_API_KEY=
RESEND_FROM=DealFinder Auctions <onboarding@resend.dev>

# Payment sandbox — mock Helcim checkout (Test-pay) and log emails to the admin outbox instead of Resend
PAYMENT_TEST_MODE=false
NEXT_PUBLIC_PAYMENT_TEST_MODE=false
NEXT_PUBLIC_SITE_URL=https://dealfinder-auctions.vercel.app
