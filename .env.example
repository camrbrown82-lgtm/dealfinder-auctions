# OpenAI (server-only) — GPT-4o vision for consignor intake
OPENAI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Auth: Confirm email ON. Disable built-in Confirm signup / Magic Link emails in
# Authentication → Emails so DealFinder Resend sends the only welcome+verify mail.
# Site URL: https://dealfinder-auctions.vercel.app
# Redirect URLs:
#   https://dealfinder-auctions.vercel.app/verify-email
#   https://dealfinder-auctions.vercel.app/reset-password
#   https://dealfinder-auctions.vercel.app/**
#   http://localhost:3000/verify-email
#   http://localhost:3000/reset-password
ADMIN_PASSWORD=hammer

# Helcim (sandbox first — paste the developer test API token Helcim emails you)
# Sandbox: https://api.helcim.test/v2
# Production: https://api.helcim.com/v2
HELCIM_API_TOKEN=
HELCIM_API_BASE_URL=https://api.helcim.test/v2
HELCIM_CURRENCY=CAD
HELCIM_BID_PREAUTH_AMOUNT=50
NEXT_PUBLIC_HELCIM_PAY_JS=https://secure.helcim.app/helcim-pay/services/start.js

# Vercel Cron
# /api/cron/sunday-preauth \u2014 Sunday $50 holds
# /api/cron/auction-close \u2014 Sunday batch invoices (also runs preauth)
CRON_SECRET=

# Pickup copy (fulfillment only — payment is Helcim, not cash or e-Transfer)
NEXT_PUBLIC_PICKUP_INSTRUCTIONS=DealFinder Auctions desk — lots are paid online with Helcim before pickup. Bring photo ID that matches your bidder profile. Pickup window: weekdays 10:00–18:00.

# Email (Resend). onboarding@resend.dev is a shared test sender and often lands in spam.
# Verify your domain in Resend (SPF + DKIM), then set:
# RESEND_FROM=DealFinder Auctions <hello@your-domain>
RESEND_API_KEY=
RESEND_FROM=DealFinder Auctions <onboarding@resend.dev>
# Desk inbox for cash-bid approval notices (Resend test sends only to this Gmail until a domain is verified)
ADMIN_NOTIFY_EMAIL=cam.r.brown82@gmail.com

# Postgres URI for `npm run sql` only (not required on Vercel)
DATABASE_URL=

# Payment sandbox — mock Helcim checkout (Test-pay) and log emails to the admin outbox instead of Resend
PAYMENT_TEST_MODE=false
NEXT_PUBLIC_PAYMENT_TEST_MODE=false
NEXT_PUBLIC_SITE_URL=https://dealfinder-auctions.vercel.app
